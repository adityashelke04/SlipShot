<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\slipshot.ico</ApplicationIcon>
    <StartupObject>SlipShot.Program</StartupObject>
    <AssemblyName>SlipShot</AssemblyName>
    <Version>0.2.8-preview.1</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\slipshot.ico" LogicalName="SlipShot.Assets.slipshot.ico" />
  </ItemGroup>
</Project>
